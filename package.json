  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^27.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.21.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "esbuild": "^0.28.2"
  },

  "cypress-cucumber-preprocessor": {
